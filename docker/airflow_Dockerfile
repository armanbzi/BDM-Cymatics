FROM apache/airflow:2.9.3-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        default-jre-headless \
        docker.io \
        docker-compose-plugin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/default-java
# Trusted-zone DAG runs `docker compose run --rm trusted-spark-batch` via host socket.
RUN usermod -aG docker airflow 2>/dev/null || true

USER airflow

# Pin numpy<2 first — base image pandas is built against numpy 1.x; opencv-python otherwise pulls numpy 2.x.
RUN pip install --no-cache-dir "numpy>=1.23.2,<2" \
    && pip install --no-cache-dir \
        python-dotenv requests scipy minio pyarrow pyspark deltalake \
    && pip install --no-cache-dir opencv-python --no-deps
